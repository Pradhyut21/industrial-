# ==============================================================================
# DeadMind Industrial Intelligence Platform — Environment Configuration
# ==============================================================================
# NOTE: DeadMind runs 100% functional in DEMO MODE with zero API keys required!
# Provide credentials below only if you wish to activate live external cloud services.
# ==============================================================================

# ── 1. LLM & Cognitive Inference (Optional — Groq Cloud) ─────────────────────
# Used for real-time LLaMA-3.3-70B response generation and continuity briefs.
# If absent, the platform uses deterministic, high-accuracy template fallbacks.
GROQ_API_KEY=your_groq_api_key_here

# ── 2. GitHub Commit Ingestion (Optional — Vault Git Ingestion) ────────────────
# Used by POST /vault/{id}/ingest/git to fetch live commit history & PR summaries.
# If absent, uses high-fidelity synthetic engineering commit history.
GITHUB_TOKEN=your_github_personal_access_token_here

# ── 3. Twilio Telephony & Messaging (Optional — Voice & WhatsApp) ─────────────
# Required for live inbound phone calls and WhatsApp interactive messaging.
# If absent, webhook routes generate valid TwiML and structured JSON stubs.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── 4. Indian Language Translation (Optional — Bhashini / Sarvam AI) ──────────
# Used for real-time translation across Hindi, Kannada, Tamil, Marathi, Telugu.
# If absent, falls back to clean English pass-through.
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
SARVAM_API_KEY=your_sarvam_api_key_here

# ── 5. Enterprise Production Scaling (Optional) ──────────────────────────────
# When unset, defaults to local SQLite (WAL mode) + FAISS in-memory vector store.
# Uncomment to connect to distributed PostgreSQL + pgvector and Redis caching:
# DATABASE_URL=postgresql://deadmind:deadmind@localhost:5432/deadmind
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

# ── 6. Operational Rate Limiting & Safety ────────────────────────────────────
AI_RATE_LIMIT=10
AI_RATE_WINDOW_SECONDS=60

# ── 7. x402 / Algorand — AI Agent Micropayment Gate (Section 9) ──────────
# Required for the x402 machine-to-machine payment protocol on Algorand.
# The x402 middleware gates GET /x402/vault/{id}/brief and
# GET /x402/vault/{id}/tasks/{task_id}/explain — AI agents pay autonomously
# with a signed Algorand transaction; no human QR code or UI interaction.
#
# TESTNET (use during development):
ALGORAND_NETWORK=testnet
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGORAND_PAYMENT_ADDRESS=                    # Your Algorand wallet address (receives payments)
ALGORAND_PAYMENT_AMOUNT_USDC=0.01            # Per-call cost in USDC (0.01 = 1 cent)
X402_FACILITATOR_URL=https://x402.goplausible.xyz/facilitate
#
# Section 9.6 — Verifier Payout Mechanic:
# When a peer stamps a vault brief as verified, the system pays the verifier
# a micro-reward from the PAYOUT_MNEMONIC wallet.
ALGORAND_PAYOUT_MNEMONIC=                    # 25-word mnemonic for payout wallet (testnet-funded)
ALGORAND_PAYOUT_AMOUNT_MICROALGO=10000       # 0.01 ALGO per verification stamp
#
# MAINNET (before submission — fund PAYMENT_ADDRESS and PAYOUT wallet with real ALGO):
# ALGORAND_NETWORK=mainnet
# ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud
# ALGORAND_INDEXER_URL=https://mainnet-idx.algonode.cloud
